        "class",
        "course",
        "attendanceDate",
        "attendanceStatus",
        "source",
        "recordedBy",
        "createdAt",
        "updatedAt"
      ]
    },
    "AttendanceAuditLog": {
      "title": "AttendanceAuditLog",
      "description": "Immutable audit log recording every manual attendance entry or correction by teachers/admins.",
      "type": "object",
      "properties": {
        "logId": { "type": "string", "minLength": 4, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "attendanceId": { "type": "string", "minLength": 4, "maxLength": 128 },
        "studentId": { "type": "string", "minLength": 4, "maxLength": 64 },
        "studentName": { "type": "string", "minLength": 2, "maxLength": 120 },
        "batchId": { "type": "string", "minLength": 1, "maxLength": 100 },
        "attendanceDate": { "type": "string", "minLength": 10, "maxLength": 10, "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
        "previousStatus": { "type": "string", "enum": ["Present", "Absent", "None"] },
        "newStatus": { "type": "string", "enum": ["Present", "Absent"] },
        "reason": { "type": "string", "minLength": 3, "maxLength": 400 },
        "modifiedBy": { "type": "string", "minLength": 2, "maxLength": 200 },
        "modifiedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "logId",
        "attendanceId",
        "studentId",
        "studentName",
        "batchId",
        "attendanceDate",
        "previousStatus",
        "newStatus",
        "reason",
        "modifiedBy",
        "modifiedAt"
      ]
    },
    "AttendanceHoliday": {
      "title": "AttendanceHoliday",
      "description": "Official holiday or non-scheduled class date override so non-class days are never counted as absences.",
      "type": "object",
      "properties": {
        "date": { "type": "string", "minLength": 10, "maxLength": 10, "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
        "title": { "type": "string", "minLength": 2, "maxLength": 120 },
        "batchId": { "type": "string", "minLength": 1, "maxLength": 100 },
        "dayType": { "type": "string", "enum": ["Holiday", "NotScheduled"] },
        "createdBy": { "type": "string", "minLength": 2, "maxLength": 200 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["date", "title", "batchId", "dayType", "createdBy", "createdAt"]
    },
    "StudentAttendancePublic": {
      "title": "StudentAttendancePublic",
      "description": "Yearly attendance ledger keyed by attid_sha256(studentId)_year (and legacy attpub_sha256(studentId:mobile)_year) for direct no-login student attendance tracking.",
      "type": "object",
      "properties": {
        "studentId": { "type": "string", "minLength": 4, "maxLength": 64 },
        "year": { "type": "number" },
        "batchId": { "type": "string", "minLength": 1, "maxLength": 100 },
        "batchTiming": { "type": "string", "maxLength": 80 },
        "enrolledDate": { "type": "string", "maxLength": 10 },
        "scheduledDays": { "type": "array", "description": "Bounded weekday list (0..6, max 7) for the student's batch." },
        "records": { "type": "object", "description": "Map of YYYY-MM-DD -> { status, entryTimeMs, exitTimeMs, batchTiming } for the given year." },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["studentId", "year", "batchId", "batchTiming", "scheduledDays", "records", "updatedAt"]
    },
    "AttendanceLookupIndex": {
      "title": "AttendanceLookupIndex",
      "description": "Privacy-minimized SHA-256 keyed lookup index of ONLY approved and active students for direct no-OTP attendance tracking (never contains raw mobile, fees, address, security codes, QR tokens, or pending/rejected/suspended students).",
      "type": "object",
      "properties": {
        "lookupType": { "type": "string", "enum": ["id", "mobile"] },
        "entries": { "type": "array", "description": "Bounded array (1..10) of active approved student attendance summaries." },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["lookupType", "entries", "updatedAt"]
    }
  },
  "firestore": {
    "/admins/{adminId}": {
      "schema": { "$ref": "#/entities/AdminUser" },
      "description": "Authorized admin UIDs."
    },
    "/applications/{applicationId}": {
      "schema": { "$ref": "#/entities/AdmissionApplication" },
      "description": "Submitted student admission applications."
    },
    "/applicationStatus/{trackingKey}": {
      "schema": { "$ref": "#/entities/ApplicationStatusLookup" },
      "description": "Non-PII application tracking record keyed by applicationNumber_studentMobile."
    },
    "/students/{studentId}": {
      "schema": { "$ref": "#/entities/StudentRecord" },
      "description": "Approved permanent student records."
    },
    "/securityCodes/{code}": {
      "schema": { "$ref": "#/entities/SecurityCodeLock" },
      "description": "Unique 4-digit security code registry."
    },
    "/batches/{batchId}": {
      "schema": { "$ref": "#/entities/Batch" },
      "description": "Batch schedule and batch fee overrides."
    },
    "/courses/{courseId}": {
      "schema": { "$ref": "#/entities/Course" },
      "description": "Available chemistry coaching courses."
    },
    "/fees/{feeId}": {
      "schema": { "$ref": "#/entities/FeeRule" },
      "description": "Fee structure rules by class, course, and batch."
    },
    "/payments/{paymentId}": {
      "schema": { "$ref": "#/entities/PaymentRecord" },
      "description": "Verified fee payment records and receipts."
    },
    "/banners/{bannerId}": {
      "schema": { "$ref": "#/entities/Banner" },
      "description": "Homepage banners managed by admin."
    },
    "/gallery/{photoId}": {
      "schema": { "$ref": "#/entities/GalleryItem" },
      "description": "Institute gallery photographs."
    },
    "/notices/{noticeId}": {
      "schema": { "$ref": "#/entities/Notice" },
      "description": "Public notice board announcements."
    },
    "/scanHistory/{scanId}": {
      "schema": { "$ref": "#/entities/ScanHistoryEntry" },
      "description": "QR scanner verification audit log."
    },
    "/settings/{settingId}": {
      "schema": { "$ref": "#/entities/InstituteSettings" },
      "description": "Global institute settings."
    },
    "/privateMedia/{mediaId}": {
      "schema": { "$ref": "#/entities/MediaBlob" },
      "description": "Private student photos and identity documents."
    },
    "/publicMedia/{mediaId}": {
      "schema": { "$ref": "#/entities/MediaBlob" },
      "description": "Public banner and gallery images."
    },
    "/trackingIndex/{lookupHash}": {
      "schema": { "$ref": "#/entities/TrackingIndex" },
      "description": "Non-PII SHA-256 lookup index for Track My Admission (no student PII exposed)."
    },
    "/studentTrackingProfiles/{profileKey}": {
      "schema": { "$ref": "#/entities/StudentTrackingProfile" },
      "description": "OTP-verified student official profile and ID card data keyed by SHA-256(applicationNumber:mobile)."
    },
    "/attendance/{attendanceId}": {
      "schema": { "$ref": "#/entities/AttendanceRecord" },
      "description": "Authoritative student attendance records keyed deterministically by att_studentId_batchId_YYYY-MM-DD."
    },
    "/attendanceAuditLogs/{logId}": {
      "schema": { "$ref": "#/entities/AttendanceAuditLog" },
      "description": "Immutable audit log of manual attendance corrections."
    },
    "/attendanceHolidays/{holidayId}": {
      "schema": { "$ref": "#/entities/AttendanceHoliday" },
      "description": "Institute-wide or batch-specific holidays and non-scheduled class date overrides."
    },
    "/studentAttendancePublic/{attendanceKey}": {
      "schema": { "$ref": "#/entities/StudentAttendancePublic" },
      "description": "Yearly student attendance ledger keyed by attid_sha256(studentId)_year (and legacy attpub_sha256(studentId:mobile)_year)."
    },
    "/attendanceLookupIndex/{lookupKey}": {
      "schema": { "$ref": "#/entities/AttendanceLookupIndex" },
      "description": "Privacy-minimized SHA-256 lookup index of approved and active students only for direct no-OTP attendance tracking."
    }
  }
}
