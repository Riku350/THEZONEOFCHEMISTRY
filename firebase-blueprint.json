{
  "entities": {
    "AdminUser": {
      "title": "AdminUser",
      "description": "Authorized institute administrator account.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "email": { "type": "string", "format": "email", "maxLength": 200 },
        "displayName": { "type": "string", "minLength": 1, "maxLength": 120 },
        "role": { "type": "string", "enum": ["owner", "admin"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email", "displayName", "role", "createdAt"]
    },
    "AdmissionApplication": {
      "title": "AdmissionApplication",
      "description": "Student admission application submitted publicly without login.",
      "type": "object",
      "properties": {
        "applicationNumber": { "type": "string", "minLength": 4, "maxLength": 40, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "trackingKey": { "type": "string", "minLength": 10, "maxLength": 64, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "studentName": { "type": "string", "minLength": 2, "maxLength": 120 },
        "studentMobile": { "type": "string", "minLength": 10, "maxLength": 15, "pattern": "^[0-9+\\-\\s]{10,15}$" },
        "studentWhatsapp": { "type": "string", "minLength": 10, "maxLength": 15, "pattern": "^[0-9+\\-\\s]{10,15}$" },
        "fatherName": { "type": "string", "minLength": 2, "maxLength": 120 },
        "fatherMobile": { "type": "string", "minLength": 10, "maxLength": 15, "pattern": "^[0-9+\\-\\s]{10,15}$" },
        "motherName": { "type": "string", "minLength": 2, "maxLength": 120 },
        "motherMobile": { "type": "string", "minLength": 10, "maxLength": 15, "pattern": "^[0-9+\\-\\s]{10,15}$" },
        "dob": { "type": "string", "maxLength": 20 },
        "gender": { "type": "string", "enum": ["Male", "Female", "Other"] },
        "address": { "type": "string", "minLength": 3, "maxLength": 400 },
        "village": { "type": "string", "minLength": 1, "maxLength": 120 },
        "postOffice": { "type": "string", "minLength": 1, "maxLength": 120 },
        "district": { "type": "string", "minLength": 1, "maxLength": 120 },
        "state": { "type": "string", "minLength": 1, "maxLength": 120 },
        "pinCode": { "type": "string", "minLength": 6, "maxLength": 6, "pattern": "^[0-9]{6}$" },
        "studentClass": { "type": "string", "enum": ["Class 10", "Class 11", "Class 12", "Other"] },
        "stream": { "type": "string", "enum": ["Science", "PCM", "PCB", "Other"] },
        "course": { "type": "string", "minLength": 2, "maxLength": 100 },
        "batch": { "type": "string", "minLength": 2, "maxLength": 80 },
        "photoUrl": { "type": "string", "maxLength": 2000 },
        "photoMediaId": { "type": "string", "maxLength": 128 },
        "idProofUrl": { "type": "string", "maxLength": 2000 },
        "idProofMediaId": { "type": "string", "maxLength": 128 },
        "marksheetUrl": { "type": "string", "maxLength": 2000 },
        "marksheetMediaId": { "type": "string", "maxLength": 128 },
        "feeAmount": { "type": "number" },
        "paidAmount": { "type": "number" },
        "paymentStatus": { "type": "string", "enum": ["PENDING", "PARTIAL", "PAID"] },
        "status": { "type": "string", "enum": ["pending", "approved", "rejected"] },
        "declarationAccepted": { "type": "boolean" },
        "studentId": { "type": "string", "maxLength": 64 },
        "remarks": { "type": "string", "maxLength": 500 },
        "submittedAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "applicationNumber",
        "trackingKey",
        "studentName",
        "studentMobile",
        "studentWhatsapp",
        "fatherName",
        "fatherMobile",
        "motherName",
        "motherMobile",
        "gender",
        "address",
        "village",
        "postOffice",
        "district",
        "state",
        "pinCode",
        "studentClass",
        "stream",
        "course",
        "batch",
        "feeAmount",
        "paidAmount",
        "paymentStatus",
        "status",
        "declarationAccepted",
        "submittedAt",
        "updatedAt"
      ]
    },
    "ApplicationStatusLookup": {
      "title": "ApplicationStatusLookup",
      "description": "Non-PII status document keyed by applicationNumber_studentMobile for student self-tracking.",
