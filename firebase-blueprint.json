        "qrToken": { "type": "string", "minLength": 4, "maxLength": 120 },
        "studentName": { "type": "string", "minLength": 2, "maxLength": 120 },
        "studentMobile": { "type": "string", "minLength": 10, "maxLength": 15 },
        "studentWhatsapp": { "type": "string", "minLength": 10, "maxLength": 15 },
        "fatherName": { "type": "string", "minLength": 2, "maxLength": 120 },
        "fatherMobile": { "type": "string", "minLength": 10, "maxLength": 15 },
        "motherName": { "type": "string", "minLength": 2, "maxLength": 120 },
        "motherMobile": { "type": "string", "minLength": 10, "maxLength": 15 },
        "dob": { "type": "string", "maxLength": 20 },
        "gender": { "type": "string", "enum": ["Male", "Female", "Other"] },
        "address": { "type": "string", "maxLength": 400 },
        "village": { "type": "string", "maxLength": 120 },
        "postOffice": { "type": "string", "maxLength": 120 },
        "district": { "type": "string", "maxLength": 120 },
        "state": { "type": "string", "maxLength": 120 },
        "pinCode": { "type": "string", "maxLength": 6 },
        "studentClass": { "type": "string", "maxLength": 40 },
        "stream": { "type": "string", "maxLength": 40 },
        "course": { "type": "string", "maxLength": 100 },
        "batch": { "type": "string", "maxLength": 80 },
        "photoUrl": { "type": "string", "maxLength": 2000 },
        "photoMediaId": { "type": "string", "maxLength": 128 },
        "idProofUrl": { "type": "string", "maxLength": 2000 },
        "idProofMediaId": { "type": "string", "maxLength": 128 },
        "marksheetUrl": { "type": "string", "maxLength": 2000 },
        "marksheetMediaId": { "type": "string", "maxLength": 128 },
        "feeAmount": { "type": "number" },
        "paidAmount": { "type": "number" },
        "paymentStatus": { "type": "string", "enum": ["PENDING", "PARTIAL", "PAID"] },
        "status": { "type": "string", "enum": ["active", "suspended"] },
        "academicSession": { "type": "string", "maxLength": 40 },
        "approvedAt": { "type": "string", "format": "date-time" },
        "approvedBy": { "type": "string", "maxLength": 200 },
        "updatedAt": { "type": "string", "format": "date-time" }
