      "required": [
        "studentId",
        "applicationId",
        "applicationNumber",
        "securityCode",
        "qrToken",
        "studentName",
        "studentMobile",
        "fatherName",
        "studentClass",
        "course",
        "batch",
        "feeAmount",
        "paidAmount",
        "paymentStatus",
        "status",
        "academicSession",
        "approvedAt",
        "updatedAt"
      ]
    },
    "SecurityCodeLock": {
      "title": "SecurityCodeLock",
      "description": "Uniqueness lock ensuring every active student has a distinct 4-digit security code.",
      "type": "object",
      "properties": {
        "code": { "type": "string", "minLength": 4, "maxLength": 4, "pattern": "^[0-9]{4}$" },
        "studentId": { "type": "string", "minLength": 4, "maxLength": 64 },
